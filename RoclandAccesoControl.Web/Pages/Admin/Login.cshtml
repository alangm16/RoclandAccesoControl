@page
@model RoclandAccesoControl.Web.Pages.Admin.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin — Rocland AccesoControl</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg: #F1F5F1;
            --surface: #FFFFFF;
            --border: #E5E7EB;
            --accent: #22C55E;
            --accent-dim: #16A34A;
            --text: #111827;
            --muted: #6B7280;
            --error: #DC2626;
            --mono: 'IBM Plex Mono', monospace;
            --sans: 'IBM Plex Sans', sans-serif;
        }
        body {
            background: var(--bg);
            font-family: var(--sans);
            min-height: 100vh;
            display: grid;
            place-items: center;
            background-image: radial-gradient(circle at 50% 0%, rgba(34,197,94,0.08), transparent 70%);
        }
        .login-card {
            width: min(420px, 92vw);
            background: var(--surface);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.06), 0 4px 12px rgba(0,0,0,0.03);
            border: 1px solid var(--border);
            padding: 40px;
        }
        .brand { margin-bottom: 36px; text-align: center; }
        .brand-tag {
            font-family: var(--mono);
            font-size: 12px;
            color: var(--accent);
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 12px;
            font-weight: 600;
        }
        .brand-name {
            font-size: 28px;
            font-weight: 700;
            color: var(--text);
            letter-spacing: -0.5px;
        }
        .brand-sub { font-size: 14px; color: var(--muted); margin-top: 6px; }
        label {
            display: block;
            font-family: var(--mono);
            font-size: 11px;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        .field { margin-bottom: 22px; }
        input[type=text], input[type=password] {
            width: 100%;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            color: var(--text);
            font-family: var(--sans);
            font-size: 15px;
            padding: 14px 16px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
        }
        .error-box {
            background: #FEF2F2;
            border: 1px solid #FECACA;
            border-radius: 12px;
            color: var(--error);
            font-size: 13px;
            font-weight: 500;
            padding: 12px 16px;
            margin-bottom: 24px;
            display: none;
        }
        .error-box.visible { display: block; }
        button[type=submit] {
            width: 100%;
            background: linear-gradient(135deg, #2D6A2D 0%, #4CAF50 100%);
            color: white;
            border: none;
            font-family: var(--sans);
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 1px;
            padding: 16px;
            border-radius: 14px;
            cursor: pointer;
            transition: all 0.2s;
            margin-top: 12px;
            box-shadow: 0 6px 14px rgba(34,197,94,0.25);
        }
        button[type=submit]:hover {
            background: linear-gradient(135deg, #1F4F1F 0%, #3D9B3D 100%);
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(34,197,94,0.3);
        }
        .footer-note {
            font-family: var(--mono);
            font-size: 11px;
            color: var(--muted);
            text-align: center;
            margin-top: 28px;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand">
            <div class="brand-tag">Panel Administrativo</div>
            <div class="brand-name">Rocland</div>
            <div class="brand-sub">Control de Acceso v1.0</div>
        </div>

        <div class="error-box @(Model.ErrorMessage != null ? "visible" : "")">
            @Model.ErrorMessage
        </div>

        <form method="post">
            @Html.AntiForgeryToken()
            <div class="field">
                <label for="usuario">Usuario</label>
                <input id="usuario" name="Usuario" type="text"
                       value="@Model.Usuario" autocomplete="username" autofocus />
            </div>
            <div class="field">
                <label for="password">Contraseña</label>
                <input id="password" name="Password" type="password"
                       autocomplete="current-password" />
            </div>
            <button type="submit">Acceder →</button>
        </form>

        <div class="footer-note">ROCLAND © 2025 · ACCESO RESTRINGIDO</div>
    </div>
</body>
</html>