<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="RoclandAccesoControl.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:RoclandAccesoControl.Mobile.Views"
       Shell.FlyoutBehavior="Disabled"
       BackgroundColor="#FFFFFF"
       TitleColor="#1A1A1A">

    <Shell.Resources>
        <ResourceDictionary>
            <!-- Tab Bar estilo light/green -->
            <Style TargetType="TabBar">
                <Setter Property="Shell.TabBarBackgroundColor" Value="#FFFFFF"/>
                <Setter Property="Shell.TabBarForegroundColor" Value="#22C55E"/>
                <Setter Property="Shell.TabBarUnselectedColor" Value="#9CA3AF"/>
                <Setter Property="Shell.TabBarTitleColor" Value="#22C55E"/>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Login (fuera del TabBar, sin NavBar) -->
    <ShellContent Route="Login"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Shell.NavBarIsVisible="False"/>

    <!-- TabBar principal: Pendientes | Dentro -->
    <TabBar Route="Main"
        Shell.TabBarBackgroundColor="#FFFFFF"
        Shell.TabBarForegroundColor="#22C55E"
        Shell.TabBarUnselectedColor="#9CA3AF"
        Shell.TabBarTitleColor="#22C55E">

    <ShellContent Title="Pendientes"
                  Route="Solicitudes"
                  Icon="icon_shield.png"
                  ContentTemplate="{DataTemplate views:SolicitudesPage}" />

    <ShellContent Title="Dentro"
                  Route="AccesosActivos"
                  Icon="icon_people.png"
                  ContentTemplate="{DataTemplate views:AccesosActivosPage}" />

</TabBar>

</Shell>
