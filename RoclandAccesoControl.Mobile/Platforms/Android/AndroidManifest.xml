<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:allowBackup="true"
                 android:icon="@mipmap/appicon"
                 android:supportsRtl="true">

        <!--
            MyFirebaseMessagingService recibe tokens nuevos y mensajes FCM.
            IMPORTANTE: el nombre debe coincidir con el namespace completo de la clase.
        -->
        <service
            android:name="com.rocland.accesocontrol.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Necesario para que Plugin.LocalNotification programe notificaciones exactas -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>